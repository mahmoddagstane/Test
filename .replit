modules = ["web", "python-3.11"]
run = "python3 web_interface.py"

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["sh", "-c", "python3 web_interface.py"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "تشغيل النظام الكامل"

[[workflows.workflow]]
name = "Run Trading Bot"
author = 40332703
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 main.py"

[[workflows.workflow]]
name = "تشغيل الواجهة"
author = 40332703
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 web_interface.py"

