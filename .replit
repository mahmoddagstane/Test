entrypoint = "main.py"
modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "main.py"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "تشغيل الواجهة"

[[workflows.workflow]]
name = "Run Trading Bot"
author = 40332703
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 main.py"

[[workflows.workflow]]
name = "تشغيل الواجهة"
author = 40332703
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 web_interface.py"
