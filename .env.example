
# Binance API Configuration (Use Testnet keys from https://testnet.binance.vision/)
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# Multi-Pair Trading Settings
BOT_TIMEFRAME=15m
BOT_RSI_PERIOD=14
RSI_OS=30
RSI_OB=70

# Risk Management (Per Pair)
ACCOUNT_PER_PAIR=200
RISK_PER_TRADE_USD=4
TAKE_PROFIT_R=1.5
BOT_MIN_NOTIONAL_USD=10

# Bot Controls
BOT_SLIPPAGE_BPS=10
BOT_POLL_SECONDS=30
BOT_LIVE=false
BOT_PRINT_BAL_EVERY=20

# Web Interface Settings
WEB_HOST=0.0.0.0
WEB_PORT=5000

# ReplDB Configuration (Auto-configured in Replit)
REPLIT_DB_URL=your_replit_db_url
