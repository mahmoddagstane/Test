
# Binance API Configuration (Use Testnet keys from https://testnet.binance.vision/)
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# Trading Settings
BOT_SYMBOL=BTC/USDT
BOT_TIMEFRAME=15m
BOT_RSI_PERIOD=14
BOT_RSI_OS=30
BOT_RSI_OB=70

# Risk Management
BOT_ALLOCATION_USD=200
BOT_RISK_USD=5
BOT_TP_R=1.5
BOT_MIN_NOTIONAL_USD=10

# Bot Controls
BOT_SLIPPAGE_BPS=10
BOT_POLL_SECONDS=30
BOT_LIVE=false
BOT_PRINT_BAL_EVERY=20
